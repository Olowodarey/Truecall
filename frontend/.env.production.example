# Vercel Frontend Environment Variables
# Add these in Vercel Dashboard: Settings → Environment Variables

# Backend API URL (REQUIRED!)
# Replace with your actual Railway backend URL
# IMPORTANT: Include /api at the end
NEXT_PUBLIC_API_URL=https://truecall-production.up.railway.app/api

# Twitter OAuth Configuration
# These should match your Twitter Developer Portal settings
NEXT_PUBLIC_TWITTER_CLIENT_ID=ZGFtYjlOY2ZlRTF3ZDFYMGJVTHo6MTpjaQ

# Twitter redirect URI (Vercel auto-constructs this based on domain)
# No need to set this in Vercel - it's dynamically generated
# NEXT_PUBLIC_TWITTER_REDIRECT_URI will be https://your-vercel-app.vercel.app/profile/twitter/callback
